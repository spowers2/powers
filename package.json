{
  "name": "power-ux",
  "version": "0.0.0",
  "private": true,
  "description": "Fine-grained reactive UI system — ownership-first, near-zero runtime, AI-readable.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "pnpm -r --filter=./packages/* run test",
    "test:core": "pnpm --filter @power-ux/core test",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "bench": "pnpm --filter @power-ux/core bench",
    "size": "pnpm --filter @power-ux/core size && pnpm --filter @power-ux/animate size && pnpm --filter @power-ux/dom size && pnpm --filter @power-ux/router size && pnpm --filter @power-ux/ui size",
    "ci": "pnpm typecheck && pnpm test && pnpm size",
    "example:counter": "pnpm --filter @power-ux/example-counter start",
    "example:kitchen-sink": "pnpm --filter @power-ux/example-kitchen-sink start",
    "example:animate": "pnpm --filter @power-ux/example-animate-demo start",
    "example:browser": "pnpm --filter @power-ux/example-browser dev",
    "example:starter": "pnpm --filter @power-ux/app-starter dev",
    "example:restaurant": "pnpm --filter @power-ux/restaurant-demo dev",
    "example:ssr-islands": "pnpm --filter @power-ux/example-ssr-islands start",
    "new-app": "bash scripts/new-app.sh",
    "create-app": "bash scripts/create-power-ux.sh",
    "clean": "pnpm -r exec rm -rf dist dist-size coverage *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
