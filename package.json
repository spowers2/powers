{
  "name": "powers",
  "version": "0.0.0",
  "private": true,
  "description": "Fine-grained reactive UI system — ownership-first, near-zero runtime, AI-readable.",
  "license": "BUSL-1.1",
  "author": "Scott Powers",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "pnpm -r --filter=./packages/* run test",
    "test:core": "pnpm --filter @powers/core test",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "bench": "pnpm --filter @powers/core bench",
    "size": "pnpm --filter @powers/core size && pnpm --filter @powers/animate size && pnpm --filter @powers/dom size && pnpm --filter @powers/router size && pnpm --filter @powers/ui size",
    "check": "pnpm typecheck && pnpm test && pnpm size",
    "ci": "pnpm run check",
    "example:counter": "pnpm --filter @powers/example-counter start",
    "example:kitchen-sink": "pnpm --filter @powers/example-kitchen-sink start",
    "example:animate": "pnpm --filter @powers/example-animate-demo start",
    "example:browser": "pnpm --filter @powers/example-browser dev",
    "example:starter": "pnpm --filter @powers/app-starter dev",
    "example:restaurant": "pnpm --filter @powers/restaurant-demo dev",
    "example:ssr-islands": "pnpm --filter @powers/example-ssr-islands start",
    "new-app": "bash scripts/new-app.sh",
    "create-app": "bash scripts/create-powers.sh",
    "design-kit:build": "pnpm --filter @powers/design-kit build",
    "design-kit:check": "pnpm --filter @powers/design-kit check",
    "design-kit:figma-audit": "pnpm --filter @powers/design-kit figma:audit",
    "clean": "pnpm -r exec rm -rf dist dist-size coverage *.tsbuildinfo",
    "gh": ".tools/gh",
    "pr:create": ".tools/gh pr create"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
