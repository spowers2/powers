{
  "name": "@power-ui/animate",
  "version": "0.1.0",
  "description": "Signal-native animation for Power UI — tweens, springs, interruptible, a11y-aware.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "size": "node --import tsx scripts/size.ts"
  },
  "dependencies": {
    "@power-ui/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
