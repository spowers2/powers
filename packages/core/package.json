{
  "name": "@powers/core",
  "version": "0.1.1",
  "description": "Fine-grained reactivity primitives for Powers — signals, computed, effects, store, resource, ownership.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "size": "node --import tsx scripts/size.ts"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
