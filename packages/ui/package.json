{
  "name": "@lab206/ui",
  "version": "0.1.8",
  "description": "Powers design system — tokens, primitives, and token-mapped utilities (batteries included).",
  "type": "module",
  "license": "BUSL-1.1",
  "sideEffects": [
    "./src/styles/tokens.css",
    "./src/styles/base.css",
    "./src/styles/utilities.css",
    "./src/styles/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./utilities.css": "./src/styles/utilities.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/code-connect/**",
    "!src/**/*.figma.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "size": "node --import tsx scripts/size.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@lab206/core": "workspace:*",
    "@lab206/dom": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "happy-dom": "^17.4.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "author": "Scott Powers",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://lab206.com",
  "bugs": {
    "url": "https://github.com/spowers2/powers/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spowers2/powers.git",
    "directory": "packages/ui"
  }
}
