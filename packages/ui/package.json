{
  "name": "@power-ux/ui",
  "version": "0.1.0",
  "description": "Power UX design system — tokens, primitives, and token-mapped utilities (batteries included).",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/styles/tokens.css",
    "./src/styles/base.css",
    "./src/styles/utilities.css",
    "./src/styles/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./utilities.css": "./src/styles/utilities.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "size": "node --import tsx scripts/size.ts"
  },
  "dependencies": {
    "@power-ux/core": "workspace:*",
    "@power-ux/dom": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "happy-dom": "^17.4.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
